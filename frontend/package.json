{
  "name": "nev-mcdm-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check:design": "node scripts/check-design-contract.mjs",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write scripts src vite.config.ts tsconfig.json package.json index.html",
    "format:check": "prettier --check scripts src vite.config.ts tsconfig.json package.json index.html",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "echarts": "6.0.0",
    "lucide-vue-next": "0.468.0",
    "vue": "3.5.22"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vue-tsc": "3.1.1"
  }
}
